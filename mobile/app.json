{
  "expo": {
    "name": "Supertime",
    "slug": "supertime",
    "scheme": "supertime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#111111"
    },
    "ios": {
      "bundleIdentifier": "com.supertime.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Supertime needs camera access for live video calls with creators.",
        "NSMicrophoneUsageDescription": "Supertime needs microphone access for live audio and video calls."
      }
    },
    "android": {
      "package": "supertime.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Supertime needs camera access for live video calls.",
          "microphonePermission": "Supertime needs microphone access for live calls."
        }
      ],
      "expo-status-bar"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "82e5c23e-9436-4cdc-88fb-112e7f8fad94"
      }
    },
    "owner": "0xmetamonkey"
  }
}
